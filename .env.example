# ---------------------------------------------------------------
# BookCart E2E — environment template (COMMITTED to GitHub)
# Copy this file to `.env` and fill real values. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------

# Application under test
BASE_URL=https://bookcart.azurewebsites.net

# Credentials for API-created test users (dummy demo site, but keep the habit:
# passwords never live in committed files)
TEST_USER_PASSWORD=Test@1234

# Optional: fail fast if the site is down / catalog is broken before suites run
HEALTH_CHECK=true
