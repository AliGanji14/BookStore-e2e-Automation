# ---------------------------------------------------------------
# BookCart E2E — environment template (COMMITTED to GitHub)
# Copy this file to `.env` and fill real values. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------

# Application under test
BASE_URL=https://bookcart.azurewebsites.net

# Credentials for API-created test users (dummy demo site, but keep the habit:
# passwords never live in committed files)
TEST_USER_PASSWORD=<your-test-password>

# Optional: username of an existing account to reuse instead of registering one.
# CI must set it (repository variable/secret) because the demo's POST /api/user
# answers 200 without persisting new users. Leave empty locally to fall back to
# the cached test account, then to API registration.
# TEST_USER_USERNAME=

# Optional: fail fast if the site is down / catalog is broken before suites run
HEALTH_CHECK=true
